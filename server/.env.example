# Backend Server Configuration Template
PORT=4000
NODE_ENV=development

# MongoDB Connection String (Atlas or Self-Hosted)
# Example Atlas: mongodb+srv://username:password@cluster0.mongodb.net/tiei_visitor_db?retryWrites=true&w=majority
# Example Local: mongodb://127.0.0.1:27017/tiei_visitor_db
MONGODB_URI=mongodb://127.0.0.1:27017/tiei_visitor_db

# Allowed Frontend Origins (comma separated, e.g. https://visitor.company.com or *)
CORS_ORIGIN=*

# Corporate SMTP Email Configuration
SMTP_HOST=smtp.company.com
SMTP_PORT=587
SMTP_USER=notifications@company.com
SMTP_PASS=your_email_password
SMTP_FROM="TIEI Visitor Management" <notifications@company.com>
